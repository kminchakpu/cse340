<%- include('partials/header') %>
<main class="new-organization-page">
  <div class="new-organization-card">
    <div class="new-organization-header">
      <h1><%= title %></h1>
      <p>Update the service project information below.</p>
    </div>
    <form
      action="/edit-project/<%= project.project_id %>"
      method="POST"
      class="new-organization-form"
    >
      <div class="new-organization-field">
        <label for="title">Project Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value="<%= project.title %>"
          minlength="3"
          maxlength="200"
          required
          placeholder="Enter project title"
        />
      </div>
      <div class="new-organization-field">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          rows="5"
          maxlength="1000"
          required
          placeholder="Enter a brief description of the service project"
        ><%= project.description %></textarea>
      </div>
      <div class="new-organization-field">
        <label for="location">Location</label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%= project.location %>"
          maxlength="200"
          required
          placeholder="Enter project location"
        />
      </div>
      <div class="new-organization-field">
        <label for="date">Project Date</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= new Date(project.date).toISOString().split('T')[0] %>"
          required
        />
      </div>
      <div class="new-organization-field">
        <label for="organizationId">Organization</label>
        <select
          id="organizationId"
          name="organizationId"
          required
        >
          <option value="">Select an organization</option>
          <% organizations.forEach(org => { %>
            <option
              value="<%= org.organization_id %>"
              <%= Number(org.organization_id) === Number(project.organization_id)
                ? 'selected'
                : '' %>
            >
              <%= org.name %>
            </option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="create-organization-btn">
        Update Project
      </button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>