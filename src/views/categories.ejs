<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <div class="category-page-actions">
    <a
      href="/new-category"
      class="add-category-btn"
    >
      + Add New Category
    </a>
  </div>

  <h2>Service Project Categories</h2>

  <ul>
    <% categories.forEach(category => { %>
      <li>
        <a href="/category/<%= category.category_id %>">
          <%= category.name %>
        </a>
      </li>
    <% }) %>
  </ul>
</main>

<%- include('partials/footer') %>