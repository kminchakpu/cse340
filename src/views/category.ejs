<%- include('partials/header') %>
<main>
  <h1><%= category.name %></h1>
  <% if (user && user.role_name === 'admin') { %>
    <div class="category-page-actions">
      <a
        href="/edit-category/<%= category.category_id %>"
        class="edit-category-btn"
      >
        Edit Category
      </a>
    </div>
  <% } %>
  <h2>Service Projects</h2>
  <% if (projects.length > 0) { %>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>There are currently no service projects in this category.</p>
  <% } %>
</main>
<%- include('partials/footer') %>