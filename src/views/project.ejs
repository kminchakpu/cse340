<%- include('partials/header') %>
<main>
  <h1><%= project.title %></h1>
  <p><%= project.description %></p>
  <p>
    Date:
    <%= new Date(project.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) %>
  </p>
  <p>Location: <%= project.location %></p>
  <p>
    Partner Organization:
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>
  <div class="project-categories">
    <strong>Categories:</strong>
    <% if (categories.length > 0) { %>
      <div class="category-tags">
        <% categories.forEach(category => { %>
          <a
            href="/category/<%= category.category_id %>"
            class="category-tag"
          >
            <%= category.name %>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <span class="no-categories">
        No categories assigned.
      </span>
    <% } %>
  </div>
  <% if (isLoggedIn) { %>
    <section class="volunteer-section">
      <h2>Volunteer</h2>
      <% if (isVolunteering) { %>
        <p class="volunteer-status">
          You are volunteering for this project.
        </p>
        <form
          action="/project/<%= project.project_id %>/remove-volunteer"
          method="POST"
          class="volunteer-form"
        >
          <button
            type="submit"
            class="remove-volunteer-btn"
          >
            Remove Volunteer Signup
          </button>
        </form>
      <% } else { %>
        <p>
          Would you like to help with this service project?
        </p>
        <form
          action="/project/<%= project.project_id %>/volunteer"
          method="POST"
          class="volunteer-form"
        >
          <button
            type="submit"
            class="volunteer-btn"
          >
            Volunteer for this Project
          </button>
        </form>
      <% } %>
    </section>
  <% } %>
  <% if (user && user.role_name === 'admin') { %>
    <div class="project-actions">
      <a
        href="/edit-project/<%= project.project_id %>"
        class="edit-project-btn"
      >
        Edit Project
      </a>
      <a
        href="/assign-categories/<%= project.project_id %>"
        class="edit-categories-btn"
      >
        Edit Categories
      </a>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>