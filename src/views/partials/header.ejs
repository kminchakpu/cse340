<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %></title>
    <link
        rel="stylesheet"
        href="/css/main.css"
    >
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >
    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >
    <link
        href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >
</head>
<body>
    <nav>
        <ul>
            <li>
                <a
                    href="/"
                    class="<%= currentPath === '/' ? 'active' : '' %>"
                >
                    Home
                </a>
            </li>
            <li>
                <a
                    href="/organizations"
                    class="<%= currentPath === '/organizations' ? 'active' : '' %>"
                >
                    Organizations
                </a>
            </li>
            <li>
                <a
                    href="/projects"
                    class="<%= currentPath === '/projects' ? 'active' : '' %>"
                >
                    Projects
                </a>
            </li>
            <li>
                <a
                    href="/categories"
                    class="<%= currentPath === '/categories' ? 'active' : '' %>"
                >
                    Categories
                </a>
            </li>
            <% if (isLoggedIn) { %>
                <li>
                    <a href="/logout">
                        Logout
                    </a>
                </li>
            <% } else { %>
                <li>
                    <a
                        href="/register"
                        class="<%= currentPath === '/register' ? 'active' : '' %>"
                    >
                        Register
                    </a>
                </li>
                <li>
                    <a
                        href="/login"
                        class="<%= currentPath === '/login' ? 'active' : '' %>"
                    >
                        Login
                    </a>
                </li>
            <% } %>
        </ul>
    </nav>
    <% const messages = flash(); %>
    <% if (Object.values(messages).some(messageList => messageList.length > 0)) { %>
        <div class="flash-container">
            <% Object.keys(messages).forEach(type => { %>
                <% messages[type].forEach(msg => { %>
                    <div
                        class="alert <%= type %>"
                        role="alert"
                    >
                        <span><%= msg %></span>
                    </div>
                <% }); %>
            <% }); %>
        </div>
    <% } %>